# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional API key from https://resend.com for sending 6-digit
# Super Admin Email OTP codes directly to bosctechedu@gmail.com.
# Also add this in Cloudflare Pages -> Settings -> Variables and Secrets for production.
RESEND_API_KEY=""

# ADMIN_OTP_FROM_EMAIL: Optional verified sender email for OTP messages.
# Defaults to "Santal Arsi Admin <onboarding@resend.dev>".
ADMIN_OTP_FROM_EMAIL=""

# ADMIN_OTP_WEBHOOK_URL: Optional alternative webhook (e.g. Google Apps Script Web App URL)
# to deliver 6-digit Admin OTP emails if not using Resend.
ADMIN_OTP_WEBHOOK_URL=""

# EMAILJS_*: Optional EmailJS credentials (https://www.emailjs.com) for sending
# 6-digit Super Admin OTP emails via your connected Gmail account.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
